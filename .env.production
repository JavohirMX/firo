MODE="production"

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------
# See the equivalent block in .env.development for why these are empty. Firo v1
# is local-first: a production build makes no outbound requests.
# ---------------------------------------------------------------------------
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# ---------------------------------------------------------------------------
# Build-time flags
# ---------------------------------------------------------------------------
# Firo has no telemetry and no code path that reads this. See NOTICE.
VITE_APP_ENABLE_TRACKING=false

# Set the below flags explicitly to false in production mode since vite loads
# and merges .env.local vars when running the build command.
# The default is that nothing is exposed.
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false

# ---------------------------------------------------------------------------
# Fonts
# ---------------------------------------------------------------------------
# Same-origin by default. Set this at build time to serve fonts from a CDN you
# control, e.g. FIRO_ASSET_CDN=https://cdn.example.com/firo/
#
# Upstream hard-coded Excalidraw's own CDN here, which would have made every
# self-hosted Firo fetch its fonts from a third party. See
# scripts/woff2/woff2-vite-plugins.js.
# FIRO_ASSET_CDN=
