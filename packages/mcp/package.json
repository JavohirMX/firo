{
  "name": "@firo/mcp",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/types/mcp/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "bin": {
    "firo-mcp": "./dist/prod/bin/firo-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/mcp/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    },
    "./*": {
      "types": "./dist/types/mcp/src/*.d.ts",
      "development": "./dist/dev/*.js",
      "production": "./dist/prod/*.js",
      "default": "./dist/prod/*.js"
    }
  },
  "files": [
    "dist/*",
    "bin/*"
  ],
  "description": "Model Context Protocol server for Firo whiteboard documents",
  "license": "MIT",
  "keywords": [
    "firo",
    "whiteboard",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "gen:types": "rimraf types && tsc",
    "build:bin": "node -e 'require(\"esbuild\").buildSync({ entryPoints: [\"bin/firo-mcp.ts\"], outfile: \"dist/prod/bin/firo-mcp.js\", bundle: true, format: \"esm\", platform: \"node\", external: [\"@firo/*\"] })'",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && yarn build:bin && yarn gen:types",
    "build": "yarn build:esm",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@firo/common": "0.1.0",
    "@firo/doc": "0.1.0",
    "@firo/fractional-indexing": "0.1.0",
    "@firo/records": "0.1.0",
    "@firo/schema": "0.1.0"
  },
  "devDependencies": {}
}
