{
  "name": "@firo/facilitation",
  "version": "0.1.0",
  "description": "Facilitation primitives for Firo: the workshop timer, dot voting, and private/reveal mode",
  "type": "module",
  "types": "./dist/types/facilitation/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/facilitation/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "keywords": [
    "firo",
    "whiteboard",
    "facilitation",
    "workshop"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@firo/doc": "0.1.0",
    "@firo/schema": "0.1.0"
  },
  "scripts": {
    "gen:types": "rimraf types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && yarn gen:types"
  }
}