{
  "name": "@firo/ui",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/types/ui/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/ui/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    },
    "./*": {
      "types": "./dist/types/ui/src/*.d.ts",
      "development": "./dist/dev/*.js",
      "production": "./dist/prod/*.js",
      "default": "./dist/prod/*.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "description": "Firo's Miro-style chrome: design tokens, theme, and shell components",
  "license": "MIT",
  "keywords": [
    "firo",
    "ui",
    "design-tokens",
    "chrome"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "gen:types": "rimraf types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && yarn gen:types"
  },
  "dependencies": {},
  "devDependencies": {}
}
