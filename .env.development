MODE="development"

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------
# Firo v1 has no server. The variables below are inherited from Excalidraw and
# are read by `apps/web/data/index.ts`, which only serves the `#json=<id>,<key>`
# shareable-link format. With `VITE_APP_BACKEND_V2_GET_URL` empty that link
# cannot resolve and the app says so rather than failing silently.
#
# Upstream pointed these at json-dev.excalidraw.com. Point them at your own
# server, or leave them empty and use local files.
# See docs/trd/08-server-and-auth.md.
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# Public library of reusable objects. Upstream used Excalidraw's. Firo's
# structured formats arrive in Phase 6 (docs/plans/phase-6-records-and-projections.md).
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# ---------------------------------------------------------------------------
# Developer flags
# ---------------------------------------------------------------------------
# put these in your .env.local, or make sure you don't commit!
# must be lowercase `true` when turned on
#
# whether to disable live reload / HMR. Usuaully what you want to do when
# debugging Service Workers.
VITE_APP_DEV_DISABLE_LIVE_RELOAD=

# Telemetry. Firo has none and ships none — see NOTICE. There is no code path
# that reads this any more; it is kept so the flag's removal is explicit rather
# than something a future reader has to rediscover.
VITE_APP_ENABLE_TRACKING=false

FAST_REFRESH=false

# The port the run the dev server
VITE_APP_PORT=3001

#Debug flags

# To enable bounding box for text containers
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=

# Set this flag to false if you want to open the overlay by default
VITE_APP_COLLAPSE_OVERLAY=true

# Set this flag to false to disable eslint
VITE_APP_ENABLE_ESLINT=true

# Enable PWA in dev server
VITE_APP_ENABLE_PWA=false

# set to true in .env.development.local to disable the prevent unload dialog
VITE_APP_DISABLE_PREVENT_UNLOAD=
